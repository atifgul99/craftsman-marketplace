      "then": {
        "properties": {
          "status_axes": {"properties": {"estimate": {"enum": ["NOT_RUN", "DRAFT_VERIFIED_INPUTS", "SUPERSEDED"]}}},
          "recommendation": {"properties": {"status": {"const": "BLOCKED"}, "component": {"type": "null"}, "method": {"type": "null"}, "amount": {"type": "null"}, "due_date": {"type": "null"}}}
