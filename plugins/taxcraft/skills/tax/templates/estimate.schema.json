      "then": {"properties": {"payment_records": {"minItems": 1, "contains": {"properties": {"status": {"const": "PAYMENT_RECONCILED"}, "confirmation_ref": {"type": "string", "minLength": 1}, "bank_settlement_ref": {"type": "string", "minLength": 1}, "taxpayer_id_match": {"const": true}, "form_match": {"const": true}, "period_match": {"const": true}, "amount_match": {"const": true}, "correct_tax_year": {"const": true}}, "required": ["status", "confirmation_ref", "bank_settlement_ref", "taxpayer_id_match", "form_match", "period_match", "amount_match", "correct_tax_year"]}}}}
    }
  ]
